pragma solidity ^0.8.28;

import "forge-std/Script.sol";
import "../src/TruchetNFT.sol";
import "../src/TruchetGate.sol";

contract Deploy is Script {
    // Mainnet USDC
    address constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;

    // ── Seed grid: 5×5 at (0,0), family (2,2,2) ──
    // Generated by: python3 -m backend.find_seed
    uint16 constant SEED_Q0 = 0;
    uint16 constant SEED_R0 = 0;
    uint8  constant SEED_W  = 5;
    uint8  constant SEED_H  = 5;
    uint256 constant SEED_POLARITIES = 33554431; // all positive

    function _seedCatalans() internal pure returns (uint128[] memory c) {
        c = new uint128[](25);
        // Column-major: col * height + row
        c[ 0]=5;   c[ 1]=65;  c[ 2]=73;  c[ 3]=106; c[ 4]=125;
        c[ 5]=36;  c[ 6]=67;  c[ 7]=92;  c[ 8]=78;  c[ 9]=40;
        c[10]=110; c[11]=62;  c[12]=58;  c[13]=48;  c[14]=42;
        c[15]=109; c[16]=127; c[17]=0;   c[18]=55;  c[19]=16;
        c[20]=32;  c[21]=112; c[22]=10;  c[23]=75;  c[24]=86;
    }

    function run() external {
        uint256 priceETH = vm.envOr("PRICE_ETH", uint256(0.005 ether));
        uint256 priceUSDC = vm.envOr("PRICE_USDC", uint256(5e6));

        vm.startBroadcast();

        TruchetNFT nft = new TruchetNFT("Truchet.Space", "TRUCHET");
        TruchetGate gate = new TruchetGate(nft, USDC, priceETH, priceUSDC);
        nft.setGate(address(gate));

        // Seed initial tiles — uniform family (2,2,2)
        uint8[] memory kas = new uint8[](25);
        uint8[] memory kbs = new uint8[](25);
        uint8[] memory kcs = new uint8[](25);
        for (uint256 i = 0; i < 25; i++) {
            kas[i] = 2; kbs[i] = 2; kcs[i] = 2;
        }
        nft.seedTiles(
            msg.sender,
            SEED_Q0, SEED_R0, SEED_W, SEED_H,
            kas, kbs, kcs,
            _seedCatalans(),
            SEED_POLARITIES
        );

        vm.stopBroadcast();
    }
}
